# Database: SQLite for local prototyping, PostgreSQL for production
DATABASE_URL=sqlite:///./payroll.db
# DATABASE_URL=postgresql+psycopg2://payroll:payroll@localhost:5432/payroll

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480

# WebAuthn relying party. RP_ID must be the registered domain (no scheme/port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Payroll Attendance
WEBAUTHN_ORIGIN=http://localhost:8000

# Seed a demo tenant + admin on first boot
SEED_DEMO_DATA=true
DEFAULT_ADMIN_EMAIL=admin@abcrestaurant.in
DEFAULT_ADMIN_PASSWORD=admin12345
